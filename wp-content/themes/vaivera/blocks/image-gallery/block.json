{
    "apiVersion": 2,
    "name": "minimalist/image-gallery",
    "version": "1.0.0",
    "title": "Minimalist Image Gallery",
    "category": "media",
    "icon": "format-gallery",
    "description": "A responsive image gallery with fullscreen lightbox slider.",
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "attributes": {
        "images": {
            "type": "array",
            "default": [],
            "source": "query",
            "selector": ".gallery-item",
            "query": {
                "id": {
                    "type": "number",
                    "source": "attribute",
                    "attribute": "data-id"
                },
                "url": {
                    "type": "string",
                    "source": "attribute",
                    "selector": "img",
                    "attribute": "src"
                },
                "fullUrl": {
                    "type": "string",
                    "source": "attribute",
                    "selector": "img",
                    "attribute": "data-full"
                },
                "alt": {
                    "type": "string",
                    "source": "attribute",
                    "selector": "img",
                    "attribute": "alt"
                },
                "caption": {
                    "type": "string",
                    "source": "html",
                    "selector": ".gallery-caption"
                }
            }
        },
        "columns": {
            "type": "number",
            "default": 3
        },
        "spacing": {
            "type": "string",
            "default": "medium"
        },
        "showCaptions": {
            "type": "boolean",
            "default": true
        }
    },
    "textdomain": "minimalist",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css",
    "style": "file:./style.css",
    "viewScript": "file:./view.js"
}