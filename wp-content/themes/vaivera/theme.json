{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "color": "#c9612c",
                    "name": "Primary"
                },
                {
                    "slug": "text",
                    "color": "#4b62a7",
                    "name": "Text"
                },
                {
                    "slug": "background",
                    "color": "#fbfaf6",
                    "name": "Background"
                },
                {
                    "slug": "accent",
                    "color": "#c9612c",
                    "name": "Accent"
                },
                {
                    "slug": "light",
                    "color": "#ffffff",
                    "name": "White"
                },
                {
                    "slug": "dark",
                    "color": "#333333",
                    "name": "Dark"
                }
            ],
            "gradients": [],
            "duotone": [],
            "custom": true,
            "customGradient": true,
            "link": true,
            "defaultPalette": false,
            "defaultGradients": false
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "Inter, sans-serif",
                    "slug": "inter",
                    "name": "Inter"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "1.5rem",
                    "name": "Large"
                },
                {
                    "slug": "x-large",
                    "size": "2rem",
                    "name": "Extra Large"
                }
            ],
            "customFontSize": true
        },
        "spacing": {
            "units": [
                "px",
                "em",
                "rem",
                "%",
                "vh",
                "vw"
            ],
            "customSpacingSize": true
        },
        "layout": {
            "contentSize": "800px",
            "wideSize": "1200px"
        }
    },
    "styles": {
        "color": {
            "background": "#fbfaf6",
            "text": "#4b62a7"
        },
        "typography": {
            "fontFamily": "Inter, sans-serif",
            "fontSize": "1rem",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "#c9612c"
                }
            },
            "h1": {
                "typography": {
                    "fontFamily": "Inter, sans-serif",
                    "fontWeight": "700",
                    "fontSize": "2.5rem",
                    "lineHeight": "1.2"
                },
                "color": {
                    "text": "#c9612c"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "Inter, sans-serif",
                    "fontWeight": "700",
                    "fontSize": "2rem",
                    "lineHeight": "1.3"
                },
                "color": {
                    "text": "#c9612c"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "Inter, sans-serif",
                    "fontWeight": "600",
                    "fontSize": "1.75rem",
                    "lineHeight": "1.3"
                },
                "color": {
                    "text": "#c9612c"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "Inter, sans-serif",
                    "fontWeight": "600",
                    "fontSize": "1.5rem",
                    "lineHeight": "1.4"
                },
                "color": {
                    "text": "#4b62a7"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "Inter, sans-serif",
                    "fontWeight": "600",
                    "fontSize": "1.25rem",
                    "lineHeight": "1.4"
                },
                "color": {
                    "text": "#4b62a7"
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "Inter, sans-serif",
                    "fontWeight": "600",
                    "fontSize": "1.1rem",
                    "lineHeight": "1.4"
                },
                "color": {
                    "text": "#4b62a7"
                }
            }
        },
        "blocks": {
            "core/button": {
                "color": {
                    "background": "#c9612c",
                    "text": "#ffffff"
                },
                "typography": {
                    "fontFamily": "Inter, sans-serif",
                    "fontWeight": "500"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "Inter, sans-serif",
                    "fontSize": "1rem",
                    "lineHeight": "1.6"
                },
                "color": {
                    "text": "#4b62a7"
                }
            }
        }
    }
}